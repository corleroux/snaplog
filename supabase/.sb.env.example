# ============================================================
# Supabase Edge Function Secrets — EXAMPLE / TEMPLATE
# ============================================================
# Location: supabase/.sb.env.example (tracked in git — NO real values here)
# Usage:
#   1. Copy to `.sb.env`:  cp supabase/.sb.env.example supabase/.sb.env
#   2. Fill in real values in `.sb.env` (gitignored — never committed)
#   3. Push with: supabase secrets set --env-file supabase/.sb.env \
#                    --project-ref <project-ref>
#
# DO NOT set these (auto-injected by Supabase at runtime):
#   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
# ============================================================

# --- REQUIRED ---

# Google Gemini API key (https://aistudio.google.com/apikey)
# Used by: extract-fabric-document, extract-vendor-document,
#          health-check, _shared/envValidation.ts
# Without it, all AI extraction returns 500 "not configured".
GEMINI_API_KEY=

# Resend API key (https://resend.com/api-keys)
# Used by: send-email-catalogue, send-notification, send-scheduled-report
RESEND_API_KEY=

# Bearer token guarding send-scheduled-report (cron / pg_cron caller must
# send: Authorization: Bearer <CRON_SECRET>)
# Generate with: openssl rand -hex 32
CRON_SECRET=

# PostHog Personal API key (phx_...), NOT the project key (phc_...).
# Create at: PostHog dashboard → Settings → Personal API keys
# Used by: poll-posthog-errors
POSTHOG_PERSONAL_API_KEY=

# GitHub token for turning feedback submissions into issues.
# Used by: submit-feedback
GITHUB_TOKEN=

# Comma-separated CORS origins for all edge functions
# (_shared/http.ts). No spaces.
# Example: https://tradefair-beta.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=

# --- OPTIONAL (have working defaults, set to override) ---

# Base app URL used in catalogue/notification email links.
# Default: https://tradefair-beta.vercel.app
# Used by: send-email-catalogue, send-notification
APP_URL=

# Base site URL used in scheduled-report links.
# Default: https://tradefair-beta.vercel.app
# Used by: send-scheduled-report
SITE_URL=

# Server-side PostHog analytics from edge functions.
# Used by: _shared/posthogEdge.ts (send-email-catalogue, send-notification,
#          submit-feedback). POSTHOG_HOST defaults to
#          https://eu.i.posthog.com — set the US host below to match
#          this project (Project ID 403472 on us.i.posthog.com).
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Gemini model override.
# Default: gemini-flash-lite-latest (_shared/geminiClient.ts)
GEMINI_MODEL=
