# ============================================================
# Supabase Edge Function Secrets — EXAMPLE / TEMPLATE
# ============================================================
# Location: supabase/.sb.env.example (tracked in git — NO real values here)
# Usage:
#   1. Copy to `.sb.env`:  cp supabase/.sb.env.example supabase/.sb.env
#   2. Fill in real values in `.sb.env` (gitignored — never committed)
#   3. Push with: supabase secrets set --env-file supabase/.sb.env \
#                    --project-ref <project-ref>
#
# DO NOT set these (auto-injected by Supabase at runtime):
#   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
# ============================================================

# --- REQUIRED ---

# Meta Model API key (https://dev.meta.ai/ — create a MODEL_API_KEY)
# Used by: extract-fabric-document, extract-vendor-document via the
#          muse-spark provider (the default since FR-MOD-02a,
#          _shared/providers/museSparkProvider.ts) — Bearer auth against
#          https://api.meta.ai/v1/chat/completions.
# Without it, extraction with the default provider returns 500
# "MODEL_API_KEY is not configured".
MODEL_API_KEY=

# Google Gemini API key (https://aistudio.google.com/apikey)
# Used by: the gemini provider (EXTRACTION_PROVIDER=gemini), health-check,
#          _shared/envValidation.ts (still required there — Gemini stays
#          configured as the baseline and FR-MOD-03 fallback candidate).
GEMINI_API_KEY=

# Resend API key (https://resend.com/api-keys)
# Used by: send-email-catalogue, send-notification, send-scheduled-report
RESEND_API_KEY=

# Bearer token guarding send-scheduled-report (cron / pg_cron caller must
# send: Authorization: Bearer <CRON_SECRET>)
# Generate with: openssl rand -hex 32
CRON_SECRET=

# PostHog Personal API key (phx_...), NOT the project key (phc_...).
# Create at: PostHog dashboard → Settings → Personal API keys
# Used by: poll-posthog-errors
POSTHOG_PERSONAL_API_KEY=

# GitHub token for turning feedback submissions into issues.
# Used by: submit-feedback
GITHUB_TOKEN=

# Comma-separated CORS origins for all edge functions
# (_shared/http.ts). No spaces.
# Example: https://tradefair-beta.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=

# --- OPTIONAL (have working defaults, set to override) ---

# Base app URL used in catalogue/notification email links.
# Default: https://tradefair-beta.vercel.app
# Used by: send-email-catalogue, send-notification
APP_URL=

# Base site URL used in scheduled-report links.
# Default: https://tradefair-beta.vercel.app
# Used by: send-scheduled-report
SITE_URL=

# Server-side PostHog analytics from edge functions.
# Used by: _shared/posthogEdge.ts (send-email-catalogue, send-notification,
#          submit-feedback). POSTHOG_HOST defaults to
#          https://eu.i.posthog.com — set the US host below to match
#          this project (Project ID 403472 on us.i.posthog.com).
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Gemini model override.
# Default: gemini-flash-lite-latest (_shared/geminiClient.ts)
GEMINI_MODEL=

# Muse Spark model override (FR-MOD-02a).
# Default: muse-spark-1.3 — Standard mode (content NOT used to train Meta
# models). Mode rule (owner directive): Standard `muse-spark-1.3` ONLY for
# vendor-card PII, the benchmark and the demo. Contributor mode
# (`muse-spark-1.3-contributor`, ~12x cheaper) may send prompts to Meta
# training — use it only for dev iterations on non-PII images (garments,
# swatches). The FR-MOD-04 benchmark runner hard-pins Standard mode.
# Other Standard-mode IDs: muse-spark-1.1 (proven fallback).
MUSE_SPARK_MODEL=

# Extraction provider used by extract-fabric-document /
# extract-vendor-document / extract-catalogue-item (FR-MOD-01,
# _shared/providers/getProvider.ts).
# Available: 'gemini', 'muse-spark', 'muse-spark-open' (Modal open-weights,
# FR-MOD-02b). Unknown values fail loudly (no fallback until FR-MOD-03).
# Default: muse-spark (all-Meta demo runtime, FR-MOD-02a)
EXTRACTION_PROVIDER=

# --- Muse Spark Open on Modal (FR-MOD-02b) ---

# Modal Proxy Token (wk-<id>.ws-<secret>) for the shared inference endpoint.
# Create: Modal dashboard → Settings → Proxy Auth Tokens.
# NOTE: a plain Modal API key (ak-...) is REJECTED with 401 on the shared
# endpoint — a proxy token is required (verified by probe).
# Used by: the muse-spark-open provider (EXTRACTION_PROVIDER=muse-spark-open).
# Set via: supabase secrets set MODAL_PROXY_TOKEN=...
MODAL_PROXY_TOKEN=

# Muse Spark Open model override (FR-MOD-02b).
# Default: meta-models/Muse-Spark-Open-816B-A42B (Modal shared endpoint,
# verified via models.dev; confirm exact ID with GET /v1/models on probe).
SPARK_OPEN_MODEL=

# --- Video pipeline (FR-VID) ---

# Full HTTPS URL of the deployed Modal video webhook
# (modal deploy modal/video_pipeline.py — owner only, consumes credits).
# This is the complete per-function endpoint URL, e.g.
# https://<workspace>--snaplog-video-pipeline-process-video.modal.run
# (shown by `modal deploy`; do NOT append a path — the edge POSTs to it as-is).
# Used by: process-video-document (hands rack videos to Modal, returns
# immediately; Modal writes results back to Supabase).
# Without it, process-video-document returns 500 "Video pipeline unavailable".
MODAL_VIDEO_ENDPOINT_URL=

# Shared secret authenticating both directions of the video pipeline:
# edge → Modal handoff AND Modal → extract-isolated-item callbacks.
# Generate with: openssl rand -hex 32
# Set in BOTH supabase secrets AND the Modal secret (snaplog-video).
VIDEO_CALLBACK_SECRET=
