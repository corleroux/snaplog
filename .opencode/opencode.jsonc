{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "delivery-manager",
  "instructions": ["AGENTS.md", "specs/decisions.md"],
  "mcp": {
    "servers": {
      "supabase": {
        "type": "remote",
        "url": "https://mcp.supabase.com/mcp?project_ref=sqshnzkgqdoiocnaunpu&features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching",
        "disabled": false
      },
      "playwright": {
        "type": "local",
        "command": ["npx", "@playwright/mcp@latest"],
        "disabled": false
      }
    }
  },
  // Ordered rules, last match wins: broad allows first, asks for
  // destructive/irreversible commands last so they refine `shell * allow`.
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "deny" },
    { "action": "playwright_*", "resource": "*", "effect": "deny" },
    // Supabase MCP (server key "supabase"). Last match wins: deny everything, re-open read-only
    // introspection, then gate anything that can write to the hosted project or expose data.
    // Account, project and cost tools stay denied by the wildcard. Migrations are applied by a human (R2).
    { "action": "supabase_*", "resource": "*", "effect": "deny" },
    { "action": "supabase_search_docs", "resource": "*", "effect": "allow" },
    { "action": "supabase_list_tables", "resource": "*", "effect": "allow" },
    { "action": "supabase_list_extensions", "resource": "*", "effect": "allow" },
    { "action": "supabase_list_migrations", "resource": "*", "effect": "allow" },
    { "action": "supabase_get_advisors", "resource": "*", "effect": "allow" },
    { "action": "supabase_list_edge_functions", "resource": "*", "effect": "allow" },
    { "action": "supabase_get_edge_function", "resource": "*", "effect": "allow" },
    { "action": "supabase_generate_typescript_types", "resource": "*", "effect": "allow" },
    { "action": "supabase_get_logs", "resource": "*", "effect": "ask" },
    { "action": "supabase_execute_sql", "resource": "*", "effect": "ask" },
    { "action": "supabase_apply_migration", "resource": "*", "effect": "ask" },
    { "action": "supabase_deploy_edge_function", "resource": "*", "effect": "ask" },
    { "action": "supabase_create_branch", "resource": "*", "effect": "ask" },
    { "action": "supabase_merge_branch", "resource": "*", "effect": "ask" },
    { "action": "supabase_rebase_branch", "resource": "*", "effect": "ask" },
    { "action": "supabase_reset_branch", "resource": "*", "effect": "ask" },
    { "action": "supabase_delete_branch", "resource": "*", "effect": "ask" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "list", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "todowrite", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "git push", "effect": "ask" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "git reset --hard", "effect": "ask" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "ask" },
    { "action": "shell", "resource": "git clean", "effect": "ask" },
    { "action": "shell", "resource": "git clean *", "effect": "ask" },
    { "action": "shell", "resource": "git checkout", "effect": "ask" },
    { "action": "shell", "resource": "git checkout *", "effect": "ask" },
    { "action": "shell", "resource": "git rm", "effect": "ask" },
    { "action": "shell", "resource": "git rm *", "effect": "ask" },
    { "action": "shell", "resource": "rm", "effect": "ask" },
    { "action": "shell", "resource": "rm *", "effect": "ask" },
    { "action": "shell", "resource": "rmdir *", "effect": "ask" },
    { "action": "shell", "resource": "mv", "effect": "ask" },
    { "action": "shell", "resource": "mv *", "effect": "ask" },
    { "action": "shell", "resource": "chmod", "effect": "ask" },
    { "action": "shell", "resource": "chmod *", "effect": "ask" },
    { "action": "shell", "resource": "sudo", "effect": "ask" },
    { "action": "shell", "resource": "sudo *", "effect": "ask" },
    { "action": "shell", "resource": "node *", "effect": "ask" },
    { "action": "shell", "resource": "node_modules/.bin/*", "effect": "ask" },
    { "action": "shell", "resource": "modal deploy*", "effect": "ask" },
    { "action": "shell", "resource": "modal run*", "effect": "ask" }
  ],
  "plugins": [
    { "package": "./plugins/graphify" }
  ],
  "agents": {
    "explore": { "model": "meta/muse-spark-1.3-contributor" }
  }
}
