# ============================================================
# Snaplog — Environment Variables
# ============================================================
# Copy this file to `.env` and fill in the values.
# NEVER commit .env, .env.local, .env.staging, or .env.local.old — all are gitignored.
#
# Variables prefixed with VITE_ are exposed to the browser bundle.
# All others are server-side only (Supabase Edge Function secrets).
# ============================================================

# --- Supabase (browser-exposed) ---
# Get these from your Supabase project dashboard → Settings → API

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- PostHog (browser-exposed) ---
# Create a project at https://posthog.com and copy the Project API Key
# Using US cloud (us.i.posthog.com)

VITE_POSTHOG_KEY=phc_your-posthog-project-api-key
VITE_POSTHOG_HOST=https://us.i.posthog.com

# --- CORS ---
# Comma-separated list of allowed origins for edge function requests
# Example: https://your-app.vercel.app,http://localhost:5173

ALLOWED_ORIGINS=http://localhost:5173

# --- Edge Function Secrets ---
# Set these via `supabase secrets set KEY=value` or the Supabase dashboard.
# They are NOT loaded from .env in production — this section is for local dev reference.

# Supabase auto-injected in edge functions (do NOT set manually in production):
# SUPABASE_URL
# SUPABASE_ANON_KEY
# SUPABASE_SERVICE_ROLE_KEY

# Must be set manually via supabase secrets:
# GEMINI_API_KEY=your-google-gemini-api-key
# RESEND_API_KEY=your-resend-api-key
# CRON_SECRET=a-long-random-string-for-scheduled-report-auth
# POSTHOG_API_KEY=phc_your-posthog-key-for-edge-functions
# POSTHOG_HOST=https://us.i.posthog.com
#
# --- PostHog Error Tracking (server-side) ---
# Personal API key for polling error tracking issues from PostHog API
# Set via: supabase secrets set POSTHOG_PERSONAL_API_KEY=phx_...
# DO NOT expose this in the browser bundle (no VITE_ prefix)
# POSTHOG_PERSONAL_API_KEY=phx_your-personal-api-key

# --- E2E Testing ---
# Used by Playwright tests against the staging environment

E2E_USER_EMAIL=your-test-user@example.com
E2E_USER_PASSWORD=your-test-password

EXPO_TOKEN=your-expo-access-token
